{
  "blocks": [
    {
      "anchor": "backup-scheduler-every-first-of-the-month-at-23-59",
      "kind": "heading",
      "level": 1,
      "text": "Backup Scheduler: Every First of the Month at 23:59"
    },
    {
      "anchor": "overview",
      "kind": "heading",
      "level": 2,
      "text": "Overview"
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "This scheduler creates a local backup once a month, specifically on the 1st day of each month at 23:59 (London time). The retention policy ensures that only the most recent six monthly backups are kept."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Frequency: Monthly, on the 1st at 23:59"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Time Window: Not restricted (start_time and end_time are unset)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention Policy: Keep the last 6 monthly backups"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Backup Type: Local backup"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Day of Month: 1"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Hour: 23"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Minute: 59"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Timezone: Europe/London"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups per year: 12 (1 per month)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Retention window: 6 most recent backups"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total retained backups at any given time: 6"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Older backups will be automatically deleted once a new backup surpasses the 6-month limit."
    },
