{
  "blocks": [
    {
      "anchor": "weekdays-workhours-backup-policy",
      "kind": "heading",
      "level": 1,
      "text": "Weekdays Workhours Backup Policy"
    },
    {
      "anchor": "introduction",
      "kind": "heading",
      "level": 2,
      "text": "Introduction"
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "This backup scheduler automates the creation of remote snapshots during weekday working hours. It ensures that critical data is consistently protected during active business periods—Monday, Wednesday, and Friday—every 12 hours from 07:00 to 19:00 UTC."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Type: backup (remote snapshot)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Days: Monday, Wednesday, Friday"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Time Window: 07:00 to 19:00 UTC"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Frequency: Every 12 hours (2 backups per day)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Timezone: Etc/UTC"
    },
    {
      "anchor": "retention-policy",
      "kind": "heading",
      "level": 2,
      "text": "Retention Policy"
    },
    {
      "anchor": "retention-policy",
      "kind": "prose",
      "text": "Retention Period: Keep remote snapshots from the last 1 month"
    },
    {
      "anchor": "retention-policy",
      "kind": "prose",
      "text": "Retention Rule: Any backup older than one calendar month will be automatically deleted, ensuring that a rotating monthly window of backups is always retained."
    },
    {
      "anchor": "remote-snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Remote Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "remote-snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups Per Week: 3 days/week × 2 backups/day = 6 backups/week"
    },
    {
      "anchor": "remote-snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups Per Month: Approx. 4.33 weeks/month × 6 = ~26 backups retained at a time"
    },
    {
      "anchor": "remote-snapshot-timeline-1-year",
      "classification": "unclassified-code",
      "kind": "code",
      "original_sha256": "febacbcb8276b1ed8637777b09e3abed3e4ca99affb2656e8bbcb847618f4338"
    },
    {
      "anchor": "remote-snapshot-timeline-1-year",
      "kind": "prose",
      "text": "The total number of retained remote snapshots does not grow over time—it stays fixed around 26, thanks to the monthly retention rule."
    },
