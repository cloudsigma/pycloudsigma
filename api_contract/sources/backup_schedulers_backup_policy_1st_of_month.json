{
  "blocks": [
    {
      "anchor": "st-of-the-month-backup-policy",
      "kind": "heading",
      "level": 1,
      "text": "1st of the Month Backup Policy"
    },
    {
      "anchor": "introduction",
      "kind": "heading",
      "level": 2,
      "text": "Introduction"
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "This backup policy is designed to take one remote snapshot per month, specifically on the 1st day of each month at 23:00 UTC. It uses a monthly retention strategy, keeping one backup per month for the last 12 months."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Frequency: Monthly, on the 1st day of every month at 23:00 UTC"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention Rule: - Keep one backup per month for the last 12 months"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "After one year of operation:"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "You will have 12 monthly backups (one for each of the past 12 months)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Older backups (beyond 12 months) are automatically deleted"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total snapshots retained after 1 year: 12"
    },
    {
