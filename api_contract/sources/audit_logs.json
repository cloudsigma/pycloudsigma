    {
      "anchor": "audit-logs",
      "kind": "heading",
      "level": 1,
      "text": "Audit logs"
    },
    {
      "anchor": "audit-logs",
      "kind": "prose",
      "text": "Note"
    },
    {
      "anchor": "audit-logs",
      "kind": "prose",
      "text": "See RFC 2616#section-9 for more details on HTTP methods semantics"
    },
    {
      "anchor": "general",
      "kind": "heading",
      "level": 2,
      "text": "General"
    },
    {
      "anchor": "general",
      "kind": "prose",
      "text": "Audit logs are used to track changes made on your resources, either by you or by other parties, like CloudSigma staff or people who have permission to access your resources."
    },
    {
      "anchor": "general",
      "kind": "prose",
      "text": "Querying is done as follows:"
    },
    {
      "anchor": "get--logs-",
      "kind": "operation",
      "method": "GET",
      "path": "/api/2.0/logs/"
    },
    {
      "anchor": "general",
      "kind": "prose",
      "text": "200 OK – no error"
    },
    {
      "anchor": "general",
      "classification": "request-example",
      "kind": "code",
      "method": "GET",
      "original_sha256": "4085b6b85123fd946f15f36958e34224ad23cb06a6592c690878e283407ac1f0",
      "path": "/api/2.0/logs/?limit=5"
    },
