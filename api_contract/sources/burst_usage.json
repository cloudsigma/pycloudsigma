    {
      "anchor": "get--dailyburstusage-",
      "kind": "operation",
      "method": "GET",
      "path": "/api/2.0/dailyburstusage/"
    },
    {
      "anchor": "id2",
      "kind": "prose",
      "text": "Get the accumulated daily burst usage of the authenticated user for the specified period (last 30 days by default)."
    },
    {
      "anchor": "id2",
      "kind": "prose",
      "text": "200 OK – no error"
    },
    {
      "anchor": "id2",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "id2",
      "classification": "request-example",
      "kind": "code",
      "method": "GET",
      "original_sha256": "50a761119daaf58321bec0021382628324eedf3f522987d9dee8a1fd131b5b9a",
      "path": "/api/2.0/dailyburstusage/?date__gt=2014-11-15&date__lt=2014-11-19"
    },
    {
      "anchor": "id2",
      "kind": "prose",
      "text": "Example response:"
    },
    {
      "anchor": "id2",
      "classification": "response-example",
      "kind": "code",
      "operation": {
        "method": "GET",
        "path": "/api/2.0/dailyburstusage/"
      },
      "original_sha256": "3a3d85c7cfe8dd9f885c6e22fa21675fa739fef6a52c48123f2d31874d9d8686",
