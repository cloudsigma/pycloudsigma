    },
    {
      "anchor": "listing",
      "kind": "heading",
      "level": 2,
      "text": "Listing"
    },
    {
      "anchor": "get--burstusage-",
      "kind": "operation",
      "method": "GET",
      "path": "/api/2.0/burstusage/"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Get the accumulated burst usage of the authenticated user for the specified period (last 30 days by default)."
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "200 OK – no error"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "listing",
      "classification": "request-example",
      "kind": "code",
      "method": "GET",
      "original_sha256": "5b91e7469d1d58547d9c9018ad7b519379f3a226ece94a452db5803e15ef7acf",
      "path": "/api/2.0/burstusage/"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Example response:"
    },
    {
      "anchor": "listing",
      "classification": "response-example",
      "kind": "code",
      "operation": {
        "method": "GET",
        "path": "/api/2.0/burstusage/"
      },
      "original_sha256": "9707789cc41c9d30ecaec39681c01ba4389cf05cd02ed248c352a60457d278b5",
      "parse_gap": "invalid-or-non-json",
      "status_code": 200
    },
    {
      "anchor": "filtering",
      "kind": "heading",
      "level": 2,
      "text": "Filtering"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "It’s possible to specify period of burst usage using filtering by date:"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "Exact: ?date=2014-10-21"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "Lower than: ?date__lt=2014-10-21"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "Lower than or equal: ?date__lte=2014-10-21"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "Greater than: ?date__gt=2014-10-21"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "Greater than or equal: ?date__gte=2014-10-21"
    },
    {
      "anchor": "filtering",
      "kind": "prose",
      "text": "Example for retrieving burst usage for the whole of July 2014:"
    },
    {
      "anchor": "filtering",
      "classification": "request-example",
      "kind": "code",
      "method": "GET",
      "original_sha256": "8274e3345e366522e4e71b23a047d9732d573cf556fc70b12e99a515a6254d0c",
      "path": "/api/2.0/burstusage/?date__gte=2014-07-01&date__lt=2014-08-01"
    },
    {
