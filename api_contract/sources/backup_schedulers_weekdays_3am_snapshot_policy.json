{
  "blocks": [
    {
      "anchor": "weekdays-3am-snapshot-policy",
      "kind": "heading",
      "level": 1,
      "text": "Weekdays 3AM Snapshot Policy"
    },
    {
      "anchor": "introduction",
      "kind": "heading",
      "level": 2,
      "text": "Introduction"
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "This snapshot policy is designed to create automatic local snapshots of your drive every weekday at 3:00 AM UTC. It uses a simple weekly retention strategy, ensuring that only the most recent three weeks of weekday snapshots are kept."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Schedule: Snapshots are taken Monday through Friday at 03:00 AM (UTC)."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Time Zone: UTC (Etc/UTC)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention Rule: - Keep all weekday snapshots from the last 3 weeks. - Snapshots older than 3 weeks are automatically deleted."
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Snapshots are created 5 times a week (Monday–Friday)."
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "With the 3-week retention rule, only the most recent 15 snapshots are kept at any time:"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "classification": "unclassified-code",
      "kind": "code",
      "original_sha256": "f4e5201e91819d53b579e1d1335cae5db0317e07f63e40fdf4eaf671237be95f"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Older snapshots are automatically removed on a rolling basis."
    },
