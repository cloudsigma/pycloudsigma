{
  "blocks": [
    {
      "anchor": "backup-scheduler-every-hour-20-0023-00",
      "kind": "heading",
      "level": 1,
      "text": "Backup Scheduler: Every Hour (20:00–23:00)"
    },
    {
      "anchor": "overview",
      "kind": "heading",
      "level": 2,
      "text": "Overview"
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "This scheduler is designed to create remote backups every hour, but only during a defined evening window—from 20:00 to 23:00 (8 PM to 11 PM), in the Europe/London timezone."
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "The retention policy retains backups for the last seven days, ensuring there is a full week of hourly backups within the evening window. Older ones are automatically deleted to save space."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Backups per day: 4 (once every hour between 20:00 and 23:00)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention window: 7 days"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Total retained backups at any time: 4 × 7 = 28 backups"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Old backups: Automatically deleted after 7 days"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups per day: 4 (once every hour between 20:00 and 23:00)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Retention window: 7 days"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total retained backups at any time: 4 × 7 = 28 backups"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups older than 7 days are automatically deleted."
    },
