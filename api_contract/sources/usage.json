      ],
      "status_code": 200
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Example:"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "To retrieve user usage data for the entire day of April 1st, 2024, the query parameters would be set like this:"
    },
    {
      "anchor": "listing",
      "classification": "response-example",
      "kind": "code",
      "operation": {
        "method": "GET",
        "path": "/api/2.0/usage/"
      },
      "original_sha256": "7f3e710935e4776128b55e6d0ca514dfaa55e47a0321e48603d940e963e9f767",
      "parse_gap": "invalid-or-non-json",
      "status_code": null
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "This request will fetch all usage data between 2024-04-01 00:00:00 and 2024-04-02 00:00:00. The limit=1500 parameter restricts the response to 1500 records."
    }
  ],
