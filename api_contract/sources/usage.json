    {
      "anchor": "get--usage-",
      "kind": "operation",
      "method": "GET",
      "path": "/api/2.0/usage/"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Retrieve the usage data for a specific time range. The start and end times are specified using the poll_time_gt (greater than) and poll_time_lt (less than) query parameters, along with an optional limit parameter to define the number of results returned."
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "200 OK – no error"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "listing",
      "classification": "unclassified-code",
      "kind": "code",
      "original_sha256": "7b78aba5b82c3b7854497f3626aa914e16397b957c88b563d8866e5b782c157e"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Example response:"
    },
    {
      "anchor": "listing",
      "classification": "response-example",
      "kind": "code",
      "operation": {
        "method": "GET",
        "path": "/api/2.0/usage/"
      },
      "original_sha256": "4d2ef886ca0c7e82c84ed8e6fe999a204f61c5c92f242214343c658b7ff1c2bb",
      "shape": [
        {
          "field_path": "$",
          "observed_types": [
            "object"
          ]
        },
        {
