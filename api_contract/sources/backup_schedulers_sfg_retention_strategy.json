      "kind": "code",
      "original_sha256": "ed6a9bb0f6e2ba7849c9938b6c5c8c83f852319eadfa75336e29cdbe52d4c281"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "All older snapshots are automatically deleted based on the rules."
    },
