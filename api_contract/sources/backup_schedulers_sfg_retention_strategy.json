  "blocks": [
    {
      "anchor": "son-father-grandfather-sfg-retention-strategy",
      "kind": "heading",
      "level": 1,
      "text": "Son, Father, Grandfather (SFG) Retention Strategy"
    },
    {
      "anchor": "introduction",
      "kind": "heading",
      "level": 2,
      "text": "Introduction"
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "The Son, Father, Grandfather (SFG) strategy is a standard industry approach to balance frequent backups with long-term storage efficiency:"
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "Son (Daily): Keeps the most recent snapshots from the last 7 days."
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "Father (Weekly): Keeps the Monday snapshot from the previous 4 weeks."
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "Grandfather (Monthly): Keeps the snapshot taken on the 23rd of each month for the last 12 months."
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "This layered structure ensures both short-term recovery and long-term archiving."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Frequency: Snapshots are taken daily at 01:00 AM GMT+12."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention Rules: - 7 daily snapshots (Son) - 4 weekly snapshots (Father – every Monday) - 12 monthly snapshots (Grandfather – 23rd of each month)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "After one year, you will retain:"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "7 daily snapshots"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "4 weekly snapshots (Mondays)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "12 monthly snapshots (23rd of each month)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total retained snapshots after 1 year:"
    },
    {
      "anchor": "snapshot-timeline-1-year",
