      "anchor": "pagination",
      "kind": "heading",
      "level": 1,
      "text": "Pagination"
    },
    {
      "anchor": "options",
      "kind": "heading",
      "level": 2,
      "text": "Options"
    },
    {
      "anchor": "options",
      "kind": "prose",
      "text": "All the API requests that return lists of objects support pagination. This is done via two GET parameters:"
    },
    {
      "anchor": "options",
      "kind": "prose",
      "text": "offset specifies the index at which to start returning objects. It is a zero based index."
    },
    {
      "anchor": "options",
      "kind": "prose",
      "text": "limit specifies the maximum number of objects to be returned. If set to 0, all resources will be returned."
    },
    {
      "anchor": "options",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "options",
      "classification": "request-example",
      "kind": "code",
      "method": "GET",
      "original_sha256": "5112a8cf7958fd68adb5141bb18d413642418204c983d54e262343df1b89952a",
      "path": "/api/2.0/servers/?limit=0"
    },
    {
      "anchor": "options",
      "kind": "prose",
      "text": "Example response:"
    },
