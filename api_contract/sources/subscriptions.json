    },
    {
      "anchor": "get--groupedsubscriptions-",
      "kind": "operation",
      "method": "GET",
      "path": "/api/2.0/groupedsubscriptions/"
    },
    {
      "anchor": "grouped-subscriptions",
      "kind": "prose",
      "text": "Returns only the first subscriptions from a chain of extended subscriptions. The extensions are listed in the ‘descendants’ attribute and the end_time is that of the last subscription in the chain."
    },
    {
      "anchor": "grouped-subscriptions",
      "kind": "prose",
      "text": "200 OK – no error"
    },
