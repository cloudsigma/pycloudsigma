    {
      "anchor": "subscriptions",
      "kind": "heading",
      "level": 1,
      "text": "Subscriptions"
    },
    {
      "anchor": "statuses",
      "kind": "heading",
      "level": 2,
      "text": "Statuses"
    },
    {
      "anchor": "statuses",
      "kind": "prose",
      "text": "Every subscription has a status associated with it:"
    },
    {
      "anchor": "statuses",
      "kind": "prose",
      "text": "active: A subscription that is currently being used, either because the current time is between its start or end date or because it was the subscription for depletable resources (traffic) that is currently being used."
    },
    {
      "anchor": "statuses",
      "kind": "prose",
      "text": "inactive: A subscription that is not currently being used, either because its not active yet or because there is another depletable resource (traffic) subscription being used."
    },
    {
      "anchor": "statuses",
      "kind": "prose",
      "text": "expired: A subscription that has either expired or that has been depleted."
    },
    {
      "anchor": "listing",
      "kind": "heading",
      "level": 2,
      "text": "Listing"
    },
    {
      "anchor": "get--subscriptions-",
      "kind": "operation",
      "method": "GET",
      "path": "/api/2.0/subscriptions/"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Gets the list of subscriptions of the user."
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "filters only subscriptions in that status. Can be one of active , inactive, expired, all, notexpired. Default is all."
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "a list (comma separated) of resources. One or more of: dssd, cpu, mem, tx, ip, vlan."
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "no error"
    },
    {
      "anchor": "listing",
      "kind": "prose",
      "text": "Example request:"
    },
    {
