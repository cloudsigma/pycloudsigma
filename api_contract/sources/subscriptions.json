    {
      "anchor": "subscription-duration",
      "kind": "heading",
      "level": 2,
      "text": "Subscription duration"
    },
    {
      "anchor": "subscription-duration",
      "kind": "prose",
      "text": "There are three parameters that determine the subscription’s duration. All times are in UTC. Not all combinations are valid:"
    },
    {
      "anchor": "subscription-duration",
      "kind": "prose",
      "text": "start_time: In ISO 8601 format. Defaults to the current time."
    },
    {
      "anchor": "subscription-duration",
      "kind": "prose",
      "text": "end_time: In ISO 8601 format."
    },
    {
      "anchor": "subscription-duration",
      "kind": "prose",
      "text": "period: Free form text describing the period. Ex: ‘2 months 1 week’."
    },
    {
      "anchor": "subscription-duration",
