    {
      "anchor": "creating",
      "kind": "heading",
      "level": 2,
      "text": "Creating"
    },
    {
      "anchor": "post--subscriptions-",
      "kind": "operation",
      "method": "POST",
      "path": "/api/2.0/subscriptions/"
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "201 Created – object created"
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Creates a new subscription. There is a limit of 500 subscriptions that can be purchased in one request."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "The resource can be a license or one of: dssd (hdd is an alias for this, but is being deprecated), cpu, mem, tx, ip, vlan."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "When buying tx, the time parameters are ignored."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Trying to purchase a subscription for IP or VLAN with an amount bigger than one will generate several subscriptions of that type."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Subscription times are rounded to noon UTC, using the following rules:"
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "End time is always rounded to the next noon."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Start time is rounded to the maximum between the current time an the previous noon. This means that subscriptions bought for now do start now, but subscriptions for the future start at the previous noon."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Warning"
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Subscriptions are mostly immutable for the customer. The only parameter that can be changed is the auto renew."
    },
    {
      "anchor": "creating",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "creating",
      "classification": "request-example",
      "kind": "code",
      "method": "POST",
      "original_sha256": "547c7647fc8cf5028c261c875cd6795c7384683cecbaa36c0d1634cd514e7e3c",
      "path": "/api/2.0/subscriptions/"
    },
