{
  "blocks": [
    {
      "anchor": "backup-scheduler-every-45-minutes",
      "kind": "heading",
      "level": 1,
      "text": "Backup Scheduler: Every 45 Minutes"
    },
    {
      "anchor": "overview",
      "kind": "heading",
      "level": 2,
      "text": "Overview"
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "This backup scheduler automatically creates backups every 45 minutes."
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "The retention policy is configured to keep backups for the last 2 days only. After this period, older backups are automatically deleted to manage storage usage."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Backup Frequency: Every 45 minutes"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Backup Type: Remote backup"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Active Days: Every day (day_of_week: [“*”])"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Time Window: All day (no start or end time defined)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Repeat Interval: Every 45 minutes (repeat.minute: “*/45”)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention Policy: Keep last 2 days"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Timezone: Europe/London"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Remote Location: ZRH (Zurich)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups per hour: ~1.33"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Backups per day: ~32 (calculated as 24 × 60 ÷ 45)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Retention Window: 2 days"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total backups retained at any time: 32 × 2 = 64 backups"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Older backups are automatically deleted once they fall outside the 2-day retention period."
    },
