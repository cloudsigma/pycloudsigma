{
  "blocks": [
    {
      "anchor": "snapshot-policy-every-12-hours-keep-last-2-days",
      "kind": "heading",
      "level": 1,
      "text": "Snapshot Policy: Every 12 Hours. Keep Last 2 Days"
    },
    {
      "anchor": "introduction",
      "kind": "heading",
      "level": 2,
      "text": "Introduction"
    },
    {
      "anchor": "introduction",
      "kind": "prose",
      "text": "This snapshot policy creates two daily snapshots, spaced 12 hours apart, and retains only the most recent 2 days of backups."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Type: snapshot"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Frequency: Every 12 hours"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Time window: From 07:00 UTC to 06:45 UTC (next day) — ensures 24h coverage"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Repeat rule: */12 (every 12 hours)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "User Timezone: Etc/UTC"
    },
    {
      "anchor": "retention-rules",
      "kind": "heading",
      "level": 2,
      "text": "Retention Rules"
    },
    {
      "anchor": "retention-rules",
      "kind": "prose",
      "text": "Keep snapshots from the last 2 days"
    },
    {
      "anchor": "retention-rules",
      "kind": "prose",
      "text": "Automatically delete anything older"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "heading",
      "level": 2,
      "text": "Snapshot Timeline (1 Year)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Snapshots per day: 2 (1 every 12 hours)"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Retention window: 2 days"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total retained snapshots at any time: 4"
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "No matter how many are created over time, the system will only keep the most recent four snapshots (2 per day × 2 days)."
    },
    {
      "anchor": "snapshot-timeline-1-year",
      "kind": "prose",
      "text": "Total snapshots after 1 year: Still four snapshots (Older ones are deleted automatically by the retention policy.)"
    },
