{
  "blocks": [
    {
      "anchor": "backup-scheduler-every-sunday-at-23-00",
      "kind": "heading",
      "level": 1,
      "text": "Backup Scheduler: Every Sunday at 23:00"
    },
    {
      "anchor": "overview",
      "kind": "heading",
      "level": 2,
      "text": "Overview"
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "This backup scheduler is designed to create a local snapshot every Sunday at 23:00 in the Europe/London timezone. It uses a simple configuration based on the day of the week and time, with no repeated interval."
    },
    {
      "anchor": "overview",
      "kind": "prose",
      "text": "A retention policy of 4 weeks ensures that only the latest four weekly snapshots are retained. This setup is ideal for low-frequency, weekly backup requirements such as routine system state or configuration snapshots."
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "heading",
      "level": 2,
      "text": "Scheduler Configuration"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Backups per week: 1 (every Sunday at 23:00)"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Retention window: 4 weeks"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Total retained snapshots at any time: 4"
    },
    {
      "anchor": "scheduler-configuration",
      "kind": "prose",
      "text": "Older snapshots are automatically deleted as new ones are created weekly."
    },
