{
  "blocks": [
    {
      "anchor": "asynchronous-server",
      "kind": "heading",
      "level": 1,
      "text": "Asynchronous server"
    },
    {
      "anchor": "authentication",
      "kind": "heading",
      "level": 2,
      "text": "Authentication"
    },
    {
      "anchor": "authentication",
      "kind": "prose",
      "text": "To use the asynchronous server, you must first authenticate through the API. This will give you a cookie that is valid for 2 minutes and that has to be used when connecting to the server."
    },
    {
      "anchor": "authentication",
      "kind": "prose",
      "text": "no error"
    },
    {
      "anchor": "authentication",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "authentication",
      "classification": "request-example",
      "kind": "code",
      "method": "POST",
      "original_sha256": "901f1e3df7ed8b424e4f5ab65445bdba57d23fad95264d8d7e999196e81cef66",
      "path": "/api/2.0/2.0/accounts/action/?do=authenticate_asynchronous"
    },
    {
      "anchor": "authentication",
      "kind": "prose",
      "text": "Example response:"
    },
    {
      "anchor": "authentication",
      "binding_gap": "no-matching-operation-declaration",
      "classification": "response-example",
      "fixture_payload": {},
      "kind": "code",
      "original_sha256": "531e35121a9cbb86642462685da3916e660518f267f02711ff091102c8a8f10b",
      "shape": [
        {
          "field_path": "$",
          "observed_types": [
            "object"
          ]
        }
      ],
      "status_code": 200
    },
    {
      "anchor": "authentication",
      "kind": "prose",
      "text": "Using this cookie will allow you to connect to the server at /2.0/websocket"
    },
    {
      "anchor": "information",
      "kind": "heading",
      "level": 2,
      "text": "Information"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "The websocket server sends frames every time one of the following changes:"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Subscriptions"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Drives"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Servers / VMs"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Networking"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Balance"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Profile"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "Jobs"
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "resource_type: A text field that describes the type of resource covered by the notification."
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "resource_uri: The URI of the resource that has changed."
    },
    {
      "anchor": "information",
      "kind": "prose",
      "text": "The JSON object might contain an ‘object’ key, that will contain the full-blown resource referenced by the notification, JSON encoded."
    }
  ],
