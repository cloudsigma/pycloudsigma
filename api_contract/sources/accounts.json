    },
    {
      "anchor": "accounts",
      "kind": "prose",
      "text": "Note"
    },
    {
      "anchor": "accounts",
      "kind": "prose",
      "text": "See RFC 2616#section-9 for more details on HTTP methods semantics"
    },
    {
      "anchor": "general",
      "kind": "heading",
      "level": 2,
      "text": "General"
    },
    {
      "anchor": "general",
      "kind": "prose",
      "text": "The accounts API supports the following actions"
    },
    {
      "anchor": "create-account",
      "kind": "heading",
      "level": 2,
      "text": "Create account"
    },
    {
      "anchor": "post--accounts-action-?do=create",
      "kind": "operation",
      "method": "POST",
      "path": "/api/2.0/accounts/action/?do=create"
    },
    {
      "anchor": "create-account",
      "kind": "prose",
      "text": "Creates an account on the system. In case of success, the user has to check his email for a confirmation link, which will ask him to create a password for the account."
    },
    {
      "anchor": "create-account",
      "kind": "prose",
      "text": "200 OK – no error"
    },
    {
      "anchor": "create-account",
      "kind": "prose",
      "text": "email – The email of the account to be created"
    },
    {
      "anchor": "create-account",
      "kind": "prose",
      "text": "promo – Promo code for initial subscriptions and demo server (optional)"
    },
    {
      "anchor": "create-account",
      "kind": "prose",
      "text": "Example request:"
    },
    {
      "anchor": "create-account",
      "classification": "request-example",
      "kind": "code",
      "method": "POST",
      "original_sha256": "edc2ceab55ec3ef8324ffde8118b904124f00dffe83f36bf1fcc8dbf06799581",
      "path": "/api/2.0/accounts/action/?do=create"
    },
